{
  "name": "lime-bike-simulator",
  "version": "2.0.0",
  "description": "Interactive Lime bike ride simulator for London: what per-minute pricing charges you for waiting at red lights",
  "type": "module",
  "main": "./dist/lime-bike-simulator.js",
  "module": "./dist/lime-bike-simulator.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lime-bike-simulator.js"
    },
    "./ssr-safe": {
      "types": "./dist/ssr-safe.d.ts",
      "import": "./dist/ssr-safe.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest run",
    "generate-route": "node scripts/generate-route.mjs",
    "build-signals": "node scripts/build-signals.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4",
    "osm-pbf-parser-node": "^1.1.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.69.0"
  },
  "keywords": [
    "lime",
    "bike",
    "simulator",
    "london",
    "cycling",
    "traffic-lights",
    "react",
    "leaflet"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattieTK/lime-bike-sim.git"
  }
}
